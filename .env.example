# Copy to .env at the repo root and fill in the values. The API reads it at start-up (a value
# already in the environment wins); docker compose reads it for the containers. Never commit
# real values: .env is git-ignored.

# Shopify Storefront API: the store with SWICA's products. Required.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# dentsu AI gateway (Claude via Azure AI Foundry). Required: the primary key and its project.
# The fallback key and project are optional; the fallback is used when the gateway refuses the
# primary key (401/403/429). `python scripts/gateway_smoke.py` checks the keys live.
FOUNDRY_SUBSCRIPTION_KEY=
FOUNDRY_PROJECT=
FOUNDRY_SUBSCRIPTION_KEY_FALLBACK=
FOUNDRY_PROJECT_FALLBACK=

# Optional, with their defaults.
# FOUNDRY_GATEWAY_URL=https://ai-api-dev.dentsu.com/foundry
# AGENT_MODEL=claude-sonnet-5
# AGENT_MEMORY_MODEL=claude-haiku-4-5
# SHOPIFY_COUNTRY=CH        # buyer country for prices (CH gives CHF)
# SHOPIFY_CURRENCY=CHF      # currency assumed when a response names none
# SHOPIFY_VENDOR=SWICA      # only this vendor's products are listed; empty lists all

# Without FOUNDRY_SUBSCRIPTION_KEY the API calls Anthropic directly with this key instead.
# ANTHROPIC_API_KEY=
