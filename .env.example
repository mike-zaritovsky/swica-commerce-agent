# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=

# dentsu AI gateway (Claude via Azure AI Foundry). When FOUNDRY_SUBSCRIPTION_KEY is set, the
# shopify_demo API sends model calls through the gateway instead of ANTHROPIC_API_KEY; the
# fallback key is used when the gateway refuses the primary one (401/403/429).
# `python scripts/gateway_smoke.py` checks the keys live. See examples/demo_common/gateway.py for the optional FOUNDRY_* settings.
# Each key travels with its own gateway project (the x-project header).
FOUNDRY_SUBSCRIPTION_KEY=
FOUNDRY_PROJECT=
FOUNDRY_SUBSCRIPTION_KEY_FALLBACK=
FOUNDRY_PROJECT_FALLBACK=
# AGENT_MODEL=claude-sonnet-5
# AGENT_MEMORY_MODEL=claude-haiku-4-5

# Shopify Storefront API (examples/shopify_demo)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
