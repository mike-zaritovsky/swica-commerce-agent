{
  "manifest_version": 3,
  "name": "SWICA AI Assistant (demo)",
  "description": "Adds the SWICA AI insurance assistant to the help menu on www.swica.ch, for demos. Affects swica.ch only.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://www.swica.ch/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "swica-csp", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.swica.ch/*"],
      "js": ["config.js", "swica-embed.js"],
      "run_at": "document_idle"
    }
  ]
}
